SPRING_PROFILES_ACTIVE=dev

PORT=8081
MANAGEMENT_PORT=9081

# Anexo J: the single database created by infra-postgres (PG_DATABASE) and the identity user.
DB_URL=jdbc:postgresql://REPLACE_DB_HOST:5432/telemed_ia
DB_USERNAME=identity_app
DB_PASSWORD=REPLACE_DB_PASSWORD

DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=5000
DB_VALIDATION_TIMEOUT_MS=3000
DB_STATEMENT_OPTIONS=-c statement_timeout=5000

HTTP_CONNECTION_TIMEOUT=5s
HTTP_KEEP_ALIVE_TIMEOUT=60s
HTTP_MAX_KEEP_ALIVE_REQUESTS=100

JWT_ISSUER=telemed-ia-identity-and-access
JWT_ACCESS_TOKEN_TTL=PT1H

# Portal page that completes a password reset; the token is appended as #token=...
PASSWORD_RESET_URL=http://localhost:4200/auth/reset-password

# Services allowed to get a service token at POST /internal/service-token (not routed by the gateway).
# Format: client-id:bcrypt-hash,client-id:bcrypt-hash. Only HASHES go here; each service keeps its own
# secret in its own .env. In this file, write every $ of a bcrypt hash as $$ (Compose interpolation).
SERVICE_CLIENTS=
SERVICE_TOKEN_TTL=PT10M

# Host paths used by Docker Compose to mount the RSA keys.
JWT_PRIVATE_KEY_HOST_FILE=/absolute/path/to/dev-private-key.pem
JWT_PUBLIC_KEY_HOST_FILE=/absolute/path/to/dev-public-key.pem

# Alternatively provide escaped PEM values when running the application directly:
# JWT_PRIVATE_KEY=REPLACE_WITH_ESCAPED_PKCS8_RSA_PEM
# JWT_PUBLIC_KEY=REPLACE_WITH_ESCAPED_X509_RSA_PEM