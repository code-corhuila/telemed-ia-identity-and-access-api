SPRING_PROFILES_ACTIVE=dev

PORT=8081
MANAGEMENT_PORT=9081

DB_URL=jdbc:postgresql://REPLACE_DB_HOST:5432/telemed_identity
DB_USERNAME=REPLACE_DB_USER
DB_PASSWORD=REPLACE_DB_PASSWORD

DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=5000
DB_VALIDATION_TIMEOUT_MS=3000
DB_STATEMENT_OPTIONS=-c statement_timeout=5000

HTTP_CONNECTION_TIMEOUT=5s
HTTP_KEEP_ALIVE_TIMEOUT=60s
HTTP_MAX_KEEP_ALIVE_REQUESTS=100

JWT_ISSUER=telemed-ia-identity-and-access
JWT_ACCESS_TOKEN_TTL=PT15M
JWT_SECRET_BASE64=REPLACE_WITH_BASE64_OF_AT_LEAST_32_RANDOM_BYTES